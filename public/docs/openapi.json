    "/api/public/articles/{username}/{slug}": {
      "get": {
        "tags": ["公开页"],
        "summary": "公开文章详情",
        "description": "返回已发布公开文章的完整内容（含渲染后的 contentHtml），并触发阅读量 +1。无需登录。",
        "security": [],
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" }, "description": "作者用户名" },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" }, "description": "文章 slug" }
        ],
        "responses": {
          "200": { "description": "文章详情", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicArticleDetail" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "页码，从 1 开始" },
      "PageSize": { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }, "description": "每页条数（最大 50）" },
      "ArticleId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "文章 ID" },
      "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "用户 ID" }
    },
    "responses": {
      "BadRequest": { "description": "请求参数不合法（400）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Unauthorized": { "description": "未登录或会话已失效（401）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "NotFound": { "description": "资源不存在或无权限（404，超管接口对非超管也返回 404 以隐藏存在性）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Conflict": { "description": "资源冲突，如用户名/邮箱已占用、slug 冲突（409）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "TooManyRequests": { "description": "尝试次数过多，账号被锁定（429）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth.session",
        "description": "登录后由服务端设置的 httpOnly 会话 Cookie（nuxt-auth-utils 默认名称通常为 auth.session）。所有需要登录的接口都会自动携带，无需在请求里手动传 token。适用于 Web 前端。"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "移动端 / 小程序 / API 客户端使用。`POST /api/auth/login` 响应中的 `token` 字段即此凭证，请求时放在请求头 `Authorization: Bearer <token>`。token 为无状态 HMAC 签名（base64url(payload).signature），含 sub(用户id)、v(tokenVersion)、exp(过期时间)，默认有效期 7 天。改密会使 `tokenVersion` 递增从而让旧 token 失效，登录接口会重新下发新 token。"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": { "type": "integer", "example": 400 },
          "statusMessage": { "type": "string", "example": "Bad Request" },
          "message": { "type": "string", "example": "参数不合法" },
          "data": { "type": "object", "nullable": true }
        }
      },
      "TokenResponse": {
        "type": "object",
        "description": "登录 / 改密后下发的 Bearer Token 凭证，移动端保存后于请求头携带 `Authorization: Bearer <token>`。",
        "properties": {
          "token": { "type": "string", "description": "HMAC 签名的无状态 Token（base64url(payload).signature）", "example": "eyJzdWIiOiIxMjMifQ.xxxxx" },
          "expiresIn": { "type": "integer", "description": "有效期（秒），默认 604800（7 天）", "example": 604800 }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "pageSize": { "type": "integer", "example": 10 },
          "total": { "type": "integer", "example": 42 },
          "totalPages": { "type": "integer", "example": 5 }
        }
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string", "example": "alice" },
          "role": { "type": "string", "enum": ["super_admin", "author"], "example": "author" },
          "displayName": { "type": "string", "example": "Alice" },
          "avatarUrl": { "type": "string", "nullable": true, "example": "https://..." },
          "tokenVersion": { "type": "integer", "example": 1 },
          "mustChangePassword": { "type": "boolean", "example": false }
        }
      },
      "ArticleDTO": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "example": "我的第一篇文章" },
          "slug": { "type": "string", "example": "my-first-post" },
          "summary": { "type": "string", "nullable": true },
          "content": { "type": "string", "description": "Markdown 原文" },
          "coverUrl": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["draft", "published", "archived"] },
          "visibility": { "type": "string", "enum": ["public", "private"] },
          "moderationNote": { "type": "string", "nullable": true },
          "publishedAt": { "type": "integer", "nullable": true, "description": "Unix 毫秒时间戳" },
          "viewCount": { "type": "integer", "example": 128 },
          "createdAt": { "type": "integer", "description": "Unix 毫秒时间戳" },
          "updatedAt": { "type": "integer", "description": "Unix 毫秒时间戳" },
          "tagIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "authorId": { "type": "string", "format": "uuid" }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "ownerId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "前端" },
          "slug": { "type": "string", "example": "frontend" },
          "createdAt": { "type": "integer", "description": "Unix 毫秒时间戳" }
        }
      },
      "PublicAuthor": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "alice" },
          "displayName": { "type": "string", "example": "Alice" },
          "avatarUrl": { "type": "string", "nullable": true },
          "bio": { "type": "string", "nullable": true }
        }
      },
      "PublicArticleListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "summary": { "type": "string", "nullable": true },
          "coverUrl": { "type": "string", "nullable": true },
          "publishedAt": { "type": "integer", "description": "Unix 毫秒时间戳" },
          "viewCount": { "type": "integer" },
          "wordCount": { "type": "integer" },
          "author": { "$ref": "#/components/schemas/PublicAuthor" },
          "tags": {
            "type": "array",
            "items": { "type": "object", "properties": { "name": { "type": "string" }, "slug": { "type": "string" } } }
          }
        }
      },
      "PublicArticleDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/PublicArticleListItem" },
          { "type": "object", "properties": { "contentHtml": { "type": "string", "description": "渲染后的 HTML 正文" } } }
        ]
      },
      "PublicTag": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "前端" },
          "slug": { "type": "string", "example": "frontend" },
          "count": { "type": "integer", "example": 12 }
        }
      },
      "PublicAuthorDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/PublicAuthor" },
          { "type": "object", "properties": { "articleCount": { "type": "integer", "example": 18 }, "role": { "type": "string", "enum": ["super_admin", "author"] } } }
        ]
      },
      "AdminUserListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "displayName": { "type": "string" },
          "email": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["super_admin", "author"] },
          "status": { "type": "string", "enum": ["pending", "active", "disabled", "rejected"] },
          "avatarUrl": { "type": "string", "nullable": true },
          "approvedBy": { "type": "string", "nullable": true },
          "approvedAt": { "type": "integer", "nullable": true, "description": "Unix 毫秒时间戳" },
          "rejectionReason": { "type": "string", "nullable": true },
          "createdAt": { "type": "integer" },
          "lastLoginAt": { "type": "integer", "nullable": true }
        }
      },
      "AdminUserListResult": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/AdminUserListItem" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" },
          "counts": {
            "type": "object",
            "properties": {
              "pending": { "type": "integer" },
              "active": { "type": "integer" },
              "disabled": { "type": "integer" },
              "rejected": { "type": "integer" }
            }
          },
          "grandTotal": { "type": "integer", "description": "不受 status 筛选影响的总数" }
        }
      },
      "AdminArticleListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "summary": { "type": "string", "nullable": true },
          "coverUrl": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["draft", "published", "archived"] },
          "visibility": { "type": "string", "enum": ["public", "private"] },
          "moderationNote": { "type": "string", "nullable": true },
          "moderatedBy": { "type": "string", "nullable": true },
          "moderatedByUsername": { "type": "string", "nullable": true },
          "moderatedAt": { "type": "integer", "nullable": true },
          "publishedAt": { "type": "integer", "nullable": true },
          "viewCount": { "type": "integer" },
          "wordCount": { "type": "integer" },
          "authorId": { "type": "string" },
          "authorUsername": { "type": "string" },
          "authorDisplayName": { "type": "string" },
          "authorAvatarUrl": { "type": "string", "nullable": true },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "tags": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "slug": { "type": "string" } } } }
        }
      },
      "AdminArticleListResult": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/AdminArticleListItem" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" },
          "counts": {
            "type": "object",
            "properties": { "draft": { "type": "integer" }, "published": { "type": "integer" }, "archived": { "type": "integer" } }
          },
          "grandTotal": { "type": "integer" }
        }
      },
      "AdminAuditLogItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "actorId": { "type": "string", "nullable": true },
          "actorUsername": { "type": "string", "nullable": true },
          "actorDisplayName": { "type": "string", "nullable": true },
          "action": { "type": "string", "example": "article.create" },
          "targetType": { "type": "string", "example": "article" },
          "targetId": { "type": "string" },
          "payload": { "type": "object", "nullable": true, "additionalProperties": true },
          "createdAt": { "type": "integer", "description": "Unix 毫秒时间戳" }
        }
      },
      "AdminAuditLogListResult": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/AdminAuditLogItem" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "MyArticleListResult": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ArticleDTO" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" },
          "counts": {
            "type": "object",
            "properties": { "draft": { "type": "integer" }, "published": { "type": "integer" }, "archived": { "type": "integer" } }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password", "captchaId", "captchaAnswer"],
        "properties": {
          "username": { "type": "string", "description": "小写，3-40 位", "example": "alice" },
          "password": { "type": "string", "example": "password123" },
          "captchaId": { "type": "string", "description": "来自 /api/auth/captcha 的 id" },
          "captchaAnswer": { "type": "string", "description": "滑块最终 x 坐标（字符串）" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password", "displayName", "captchaId", "captchaAnswer"],
        "properties": {
          "username": { "type": "string", "description": "小写，3-40 位" },
          "password": { "type": "string", "minLength": 8, "maxLength": 200 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "email": { "type": "string", "format": "email", "nullable": true },
          "captchaId": { "type": "string" },
          "captchaAnswer": { "type": "string" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string" },
          "newPassword": { "type": "string", "minLength": 8, "maxLength": 200 }
        }
      },
      "BootstrapRequest": {
        "type": "object",
        "required": ["username", "password", "displayName"],
        "properties": {
          "username": { "type": "string", "description": "小写，3-40 位" },
          "password": { "type": "string", "minLength": 8, "maxLength": 200 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 50 }
        }
      },
      "ArticleUpsertRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "创建时必填，更新时可选" },
          "slug": { "type": "string", "description": "可选，仅小写字母/数字/连字符" },
          "summary": { "type": "string", "maxLength": 500, "nullable": true },
          "content": { "type": "string", "maxLength": 200000, "description": "Markdown 正文" },
          "coverUrl": { "type": "string", "format": "uri", "maxLength": 1000, "nullable": true },
          "tagIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "maxItems": 10 }
        }
      },
      "ArticleStatusRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["publish", "unpublish", "archive"] }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "bio": { "type": "string", "maxLength": 500, "nullable": true },
          "avatarUrl": { "type": "string", "maxLength": 1000, "nullable": true, "description": "头像地址：公网 http(s) URL 或本站 /api/blob/avatars/... 代理路径（私有 Blob store）" }
        }
      },
      "TagCreateRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 30 }
        }
      },
      "RejectRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "maxLength": 500, "nullable": true }
        }
      },
      "AdminBulkRequest": {
        "type": "object",
        "required": ["ids", "action"],
        "properties": {
          "ids": { "type": "array", "items": { "type": "string", "format": "uuid" }, "minItems": 1, "maxItems": 50 },
          "action": { "type": "string", "enum": ["hide", "show", "delete"] }
        }
      },
      "AdminArticleModerateRequest": {
        "type": "object",
        "description": "status / visibility / note 至少指定一项",
        "properties": {
          "status": { "type": "string", "enum": ["draft", "published", "archived"] },
          "visibility": { "type": "string", "enum": ["public", "private"] },
          "note": { "type": "string", "maxLength": 500, "nullable": true }
        }
      }
    }
  }
}