        }
      }
    },
    "/api/public/authors/{username}/articles": {
      "get": {
        "tags": ["公开页"],
        "summary": "作者的公开文章列表",
        "description": "返回某作者的已发布公开文章（分页 + 搜索）。无需登录。",
