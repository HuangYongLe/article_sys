{
  "openapi": "3.0.3",
  "info": {
    "title": "文章发布平台 API",
    "version": "1.0.0",
    "description": "Nuxt 4 + Nitro 文章发布平台的 REST API 说明文档。\n\n**鉴权方式（两种并存）**：\n1. **Cookie 会话（Web 前端）**：调用 `POST /api/auth/login` 成功后，服务端写入 httpOnly 会话 Cookie，后续需登录的接口自动携带即可。\n2. **Bearer Token（小程序 / 移动端 / API 客户端）**：同一登录接口除 Cookie 外还会在响应中返回 `token` 与 `expiresIn`。客户端自行保存 token，并在后续请求头携带 `Authorization: Bearer <token>`。token 为 HMAC 签名、含用户 id 与 `tokenVersion`，服务器验签后复核；改密或强制下线会使旧 token 立即失效。\n\n**错误处理**：除 200 外的错误响应均为 `{ statusCode, statusMessage?, message, data? }` 结构，见 #/components/schemas/ErrorResponse。\n\n**公共约定**：所有时间戳字段为 Unix 毫秒时间戳（number）；分页接口统一返回 `{ items, meta: { page, pageSize, total, totalPages } }`。",
    "contact": { "name": "article_sys" }
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "本地开发环境 (npm run dev)" },
    { "url": "https://www.tooi.top", "description": "生产环境 (Vercel)" }
  ],
  "tags": [
    { "name": "认证", "description": "人机验证、登录、注册、会话、改密、初始化" },
    { "name": "文章", "description": "作者对自己文章的增删改查、发布状态、slug 校验" },
    { "name": "标签", "description": "作者个人标签管理" },
    { "name": "资料与上传", "description": "个人资料更新、封面上传" },
    { "name": "中控台-用户", "description": "超级管理员对用户进行审核与启用/禁用" },
    { "name": "中控台-文章", "description": "超级管理员对文章进行治理、批量操作与审核" },
    { "name": "中控台-审计", "description": "超级管理员查看审计日志" },
    { "name": "公开页", "description": "无需登录的聚合页、标签云、作者页与文章详情" },
    { "name": "系统", "description": "健康检查与一次性初始化" }
  ],
  "security": [{ "session": [] }, { "bearerAuth": [] }],
  "paths": {
    "/api/_health": {
      "get": {
        "tags": ["系统"],
        "summary": "健康检查",
        "description": "探测服务与数据库连接状态。无需登录。",
        "security": [],
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "dbTime": { "type": "string", "nullable": true, "example": "2026-08-07 01:23:45" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/captcha": {
      "get": {
        "tags": ["认证"],
        "summary": "获取滑块拼图人机验证挑战",
        "description": "生成滑块拼图几何参数，正确位置（targetX）写入 httpOnly Cookie（cm_captcha，5 分钟有效）。前端用 id + 几何参数绘制拼图，用户拖动后把滑块 x 坐标作为 captchaAnswer 回传。无需登录。",
        "security": [],
        "responses": {
          "200": {
            "description": "挑战参数",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "挑战 ID，提交时作为 captchaId" },
                    "targetX": { "type": "number", "description": "缺口正确 x 坐标" },
                    "y": { "type": "number", "description": "缺口 y 坐标" },
                    "width": { "type": "number" },
                    "height": { "type": "number" },
                    "pieceSize": { "type": "number", "description": "拼图块尺寸" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "登录",
        "description": "校验人机验证 + 账号密码。成功写入会话 Cookie 并返回会话用户；同时为移动端返回 `token` 与 `expiresIn`，客户端可保存后用 `Authorization: Bearer <token>` 调用需登录接口。失败不区分「用户不存在 / 密码错误」。连续 5 次失败锁定 10 分钟。账号非 active（pending/rejected/disabled）将被拒绝。无需登录。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "user": { "$ref": "#/components/schemas/SessionUser" },
                    "token": { "type": "string", "description": "Bearer Token，移动端/小程序在后续请求头 `Authorization: Bearer <token>` 携带", "example": "eyJzdWIiOiIxMjMifQ.xxxxx" },
                    "expiresIn": { "type": "integer", "description": "token 有效期（秒），默认 604800（7 天）", "example": 604800 }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["认证"],
        "summary": "自助注册",
        "description": "创建普通作者账号，默认进入 pending（待超管审核）。需人机验证。用户名/邮箱唯一。无需登录。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
        },
        "responses": {
          "200": {
            "description": "注册成功，等待审核",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "status": { "type": "string", "example": "pending" },
                    "message": { "type": "string", "example": "注册成功，等待管理员审核通过后方可登录" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["认证"],
        "summary": "获取当前登录用户",
        "description": "回源数据库刷新会话（角色/状态变化后用于同步），返回会话用户及其 bio、email。",
        "responses": {
          "200": {
            "description": "当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/SessionUser" },
                    "bio": { "type": "string", "nullable": true },
                    "email": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "登出",
        "description": "清除会话 Cookie（Web 前端）。移动端为无状态 Token，登出时客户端本地丢弃 token 即可；如需让所有设备（含移动端）强制下线，可调用「修改密码」使 tokenVersion 递增从而令旧 token 失效。",
        "responses": {
          "200": {
            "description": "已登出",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "ok": { "type": "boolean", "example": true } } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": ["认证"],
        "summary": "修改密码",
        "description": "校验当前密码后更新。会使其他设备的旧会话失效（tokenVersion + 1），当前设备保持登录。移动端的旧 token 会因 tokenVersion 递增而失效，故本接口会重新下发新 token。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } } }
        },
        "responses": {
          "200": {
            "description": "修改成功，重新下发 token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "token": { "type": "string", "description": "改密后重新签发的 Bearer Token（旧 token 已失效）", "example": "eyJzdWIiOiIxMjMifQ.yyyyy" },
                    "expiresIn": { "type": "integer", "description": "新 token 有效期（秒）", "example": 604800 }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/_setup/bootstrap": {
      "post": {
        "tags": ["系统", "认证"],
        "summary": "一次性初始化首个超级管理员",
        "description": "仅当 users 表为空时可调用，创建首个超级管理员并建立会话。之后永久返回 410。无需登录。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapRequest" } } }
        },
        "responses": {
          "200": {
            "description": "初始化成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "user": { "$ref": "#/components/schemas/SessionUser" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "410": {
            "description": "系统已初始化",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/articles": {
      "get": {
        "tags": ["文章"],
        "summary": "我的文章列表",
        "description": "返回当前作者本人的文章（分页 + 状态筛选 + 搜索），并附带各状态计数。",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["draft", "published", "archived"] }, "description": "按状态筛选" },
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "搜索标题/摘要" }
        ],
        "responses": {
          "200": {
            "description": "我的文章列表",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MyArticleListResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["文章"],
        "summary": "创建文章",
        "description": "创建新文章。slug 可选（缺省由标题生成，冲突自动加后缀）；tagIds 必须属于当前作者。正文经 Markdown 渲染为 contentHtml。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleUpsertRequest" } } }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleDTO" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/articles/slug-check": {
      "get": {
        "tags": ["文章"],
        "summary": "校验 slug 是否可用",
        "description": "检查当前作者是否已有该 slug（编辑时可用 excludeId 排除自身）。",
        "parameters": [
          { "name": "slug", "in": "query", "required": true, "schema": { "type": "string" }, "description": "要校验的 slug（仅小写字母、数字、连字符）" },
          { "name": "excludeId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" }, "description": "编辑场景下排除的文章 ID" }
        ],
        "responses": {
          "200": {
            "description": "可用性结果",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "available": { "type": "boolean", "description": "true=可用" } } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/articles/{id}": {
      "get": {
        "tags": ["文章"],
        "summary": "文章详情（作者视角）",
        "description": "返回文章完整 DTO（含 content 原文与 tagIds）。仅作者本人或超管可访问。",
        "parameters": [{ "$ref": "#/components/parameters/ArticleId" }],
        "responses": {
          "200": { "description": "文章详情", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleDTO" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["文章"],
        "summary": "更新文章",
        "description": "部分更新文章字段。修改 slug 时校验冲突；content 变更会重新渲染 contentHtml 并刷新字数；tagIds 为整体替换（必须属于当前作者）。",
        "parameters": [{ "$ref": "#/components/parameters/ArticleId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ArticleUpsertRequest" },
              "description": "所有字段均可选（partial）"
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleDTO" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "tags": ["文章"],
        "summary": "删除文章",
        "description": "删除文章及其标签关联。仅作者本人或超管可操作。",
        "parameters": [{ "$ref": "#/components/parameters/ArticleId" }],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean", "example": true } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/articles/{id}/status": {
      "post": {
        "tags": ["文章"],
        "summary": "变更文章状态（发布/取消发布/归档）",
        "description": "作者只能改 status，visibility 归超管管。publish 时若从未发布则写入 publishedAt。",
        "parameters": [{ "$ref": "#/components/parameters/ArticleId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleStatusRequest" } } }
        },
        "responses": {
          "200": { "description": "状态已更新", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleDTO" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": ["标签"],
        "summary": "我的标签列表",
        "description": "返回当前作者的全部标签（按名称升序）。",
        "responses": {
          "200": {
            "description": "标签列表",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["标签"],
        "summary": "创建标签",
        "description": "创建标签（同名同 slug 幂等，直接返回已有标签）。slug 由名称生成。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagCreateRequest" } } }
        },
        "responses": {
          "200": { "description": "创建成功（或返回已有标签）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/tags/{id}": {
      "delete": {
        "tags": ["标签"],
        "summary": "删除标签",
        "description": "删除当前作者拥有的标签（同时解除文章绑定）。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "标签 ID" }],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean", "example": true } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/profile": {
      "patch": {
        "tags": ["资料与上传"],
        "summary": "更新个人资料",
        "description": "更新当前用户的 displayName / bio / avatarUrl，并刷新会话。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileUpdateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean", "example": true } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/upload/cover": {
      "post": {
        "tags": ["资料与上传"],
        "summary": "上传封面图",
        "description": "multipart/form-data 上传封面。仅支持 JPG/PNG/WebP/GIF，最大 5MB。本地开发写入 public/uploads，生产走私有 Vercel Blob（access:private）。返回同源代理路径 /api/blob/covers/...（由 /api/blob 代理签发限时签名 URL 转发，访客可见）。",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "file": { "type": "string", "format": "binary", "description": "图片文件" } },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "example": "/api/blob/covers/<userId>/<nanoid>.webp" } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/upload/avatar": {
      "post": {
        "tags": ["资料与上传"],
        "summary": "上传头像",
        "description": "multipart/form-data 上传头像。仅支持 JPG/PNG/WebP/GIF，最大 2MB。本地开发写入 public/uploads，生产走私有 Vercel Blob（access:private）。返回同源代理路径 /api/blob/avatars/...（由 /api/blob 代理签发限时签名 URL 转发，访客可见）。",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "file": { "type": "string", "format": "binary", "description": "图片文件" } },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "example": "/api/blob/avatars/<userId>/<nanoid>.png" } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": ["中控台-用户"],
        "summary": "用户列表",
        "description": "超级管理员分页查询用户，支持 status/role 筛选与关键字搜索，返回各状态计数与不受 status 影响的 grandTotal。",
