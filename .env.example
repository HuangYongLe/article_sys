# Session 加密密钥，openssl rand -base64 32 生成（>= 32 字符）
NUXT_SESSION_PASSWORD=

# 移动端 Bearer Token 的 HMAC 签名密钥（建议 >= 32 字符，可与上面的 Cookie 密钥不同）
# 缺省时复用 NUXT_SESSION_PASSWORD
AUTH_TOKEN_SECRET=

# 本地开发: file:./local.db  生产: libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=file:./local.db
# 生产必填: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# Vercel Blob 图片上传（可选，缺省时降级为 URL 输入）
BLOB_READ_WRITE_TOKEN=

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=林栖
